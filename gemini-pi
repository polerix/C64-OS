#!/usr/bin/env python3
import os
import sys
import json
import requests

# CONFIGURATION
API_KEY_FILE = os.path.expanduser("~/.gemini_key")
GEMINI_API_URL = "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-lite:generateContent"

def get_api_key():
    """Retrieves the API key from the secure file."""
    if not os.path.exists(API_KEY_FILE):
        print("?DEVICE NOT PRESENT ERROR: API KEY MISSING")
        sys.exit(1)
    
    with open(API_KEY_FILE, "r") as f:
        key = f.read().strip()
    return key

def query_gemini(prompt):
    """Sends a prompt to the Gemini API and returns the response text."""
    api_key = get_api_key()
    headers = {"Content-Type": "application/json"}
    payload = {
        "contents": [{
            "parts": [{"text": prompt}]
        }]
    }
    
    try:
        response = requests.post(f"{GEMINI_API_URL}?key={api_key}", headers=headers, json=payload)
        response.raise_for_status()
        data = response.json()
        
        # Extract text from response
        try:
            text = data["candidates"][0]["content"]["parts"][0]["text"]
            return text
        except (KeyError, IndexError):
            return "?SYNTAX ERROR: UNEXPECTED API RESPONSE"
            
    except requests.exceptions.RequestException as e:
        return f"?IO ERROR: {str(e)}"

def main():
    if len(sys.argv) > 1:
        # Single command mode
        prompt = " ".join(sys.argv[1:])
        print(query_gemini(prompt))
    else:
        # Interactive mode
        print("GEMINI 2.0 FLASH-LITE INTERFACE ACTIVE.")
        print("READY.")
        while True:
            try:
                user_input = input("USER: ")
                if user_input.upper() in ["EXIT", "QUIT", "BYE"]:
                    break
                
                response = query_gemini(user_input)
                print(f"GEMINI: {response}")
                print("READY.")
            except KeyboardInterrupt:
                break
            except EOFError:
                break

if __name__ == "__main__":
    main()
